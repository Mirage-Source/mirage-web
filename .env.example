# ── Upstream MIRAGE API ──────────────────────────────────────────────────────
# The Go API from mirage-core (cmd/api). It binds to 127.0.0.1:8080 in
# docker-compose, so in production this app runs on the same host, or reaches
# it over an SSH tunnel / private network.
#
# Leave MIRAGE_API_URL unset to run the whole app against bundled fixtures --
# every view works, no sensor required. That is the default for local design
# work, and it is how `npm run dev` behaves out of the box.
MIRAGE_API_URL=http://127.0.0.1:8080

# The single API key mirage-core's API expects in X-API-Key. This is read ONLY
# in server code (src/lib/upstream.ts). It is never sent to the browser, and it
# must never be prefixed NEXT_PUBLIC_.
MIRAGE_API_KEY=

# ── Operator access ──────────────────────────────────────────────────────────
# Password for /console. Anyone with it can see raw commands, credentials and
# full source addresses, and can change what the sensor does. Generate one:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
OPERATOR_PASSWORD=

# Secret used to sign the operator session cookie. Generate the same way.
SESSION_SECRET=

# ── Public surface ───────────────────────────────────────────────────────────
# Serve the sanitised aggregate page at "/". Set to "false" to make the whole
# deployment operator-only (visiting "/" then redirects to /console).
PUBLIC_VIEW=true

# ── Geo attribution ──────────────────────────────────────────────────────────
# Directory holding the pinned DB-IP Lite CSVs that ship with mirage-core
# (data/geo/dbip-country-lite.csv and dbip-asn-lite.csv). The sensor stores no
# country or ASN, so this app resolves addresses itself. Leave unset and it
# looks for ../mirage-core-main/mirage-core-main/data/geo, ../mirage-core/data/geo,
# then ./data/geo. With none of them present the Geography view says so.
# MIRAGE_GEO_DIR=/opt/mirage-core/data/geo
